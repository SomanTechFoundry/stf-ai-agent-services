# ============================================================
# STF AI Agent Services — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Application ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Database (Required) ----
# Neon PostgreSQL — get connection strings from your Neon project dashboard
# The pooled URL is used by Prisma Client at runtime
# The direct URL is used by Prisma Migrate
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# ---- AI Providers ----
# At least one is required for Phase 3+
# Start with Gemini — get key at https://aistudio.google.com/
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI — add later
OPENAI_API_KEY=

# Anthropic — add later
ANTHROPIC_API_KEY=

# ---- Twilio (Phase 5 — SMS confirmations) ----
# Sign up at https://www.twilio.com/
# 1. Create an account → get Account SID and Auth Token from Console Dashboard
# 2. Purchase a phone number → put it in TWILIO_PHONE_NUMBER (E.164, e.g. +12145551234)
# 3. Upgrade your Twilio account to send custom confirmation SMS to any recipient
# 4. Set inbound webhook: https://your-domain.com/api/webhooks/twilio/sms
# If any of these are missing, SMS is skipped (logged, booking still succeeds).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Fallback business slug when inbound SMS "To" doesn't match business.phone
TWILIO_BUSINESS_SLUG=sunset-salon

# ---- Google Calendar (Future) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---- Resend (Phase 5 — Email confirmations) ----
# Sign up at https://resend.com/ — free tier: 3,000 emails/month
# 1. Create an account → API Keys → Create API Key
# 2. Add and verify your sending domain, or use onboarding@resend.dev for testing
# 3. Set RESEND_FROM_EMAIL to a verified address on your domain
# If RESEND_API_KEY is missing, email is silently skipped (no error).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---- Stripe (Future — Client Subscriptions) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Sentry (Phase 6 — Error Monitoring) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Security ----
# A strong random secret for signing internal API tokens and dashboard sessions
# Generate with: openssl rand -hex 32
# Required for /dashboard login (session cookies)
API_SECRET_KEY=

# ---- Rate Limiting ----
RATE_LIMIT_AGENT_RPM=60
